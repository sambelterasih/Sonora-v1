# Set these as Cloudflare Worker secrets, never in frontend files.
# SONOVAULT_API_KEY=your_sonovault_key
# GETSONGBPM_API_KEY=your_getsongbpm_key
# YOUTUBE_API_KEY=optional_youtube_data_api_key
# OPENAI_API_KEY=optional_explanation_key
# ACRCloud Identify: keep credentials in Cloudflare Worker Secrets.
# ACRCLOUD_ACCESS_KEY=your_acrcloud_project_access_key
# ACRCLOUD_ACCESS_SECRET=your_acrcloud_project_access_secret
# ACRCLOUD_HOST=your-project-region-hostname (plain Worker variable)
